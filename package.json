{
  "name": "kovix",
  "description": "AI-native development environment with Plan→Approve→Execute→Verify agent loop, multi-provider LLM, MCP servers, and semantic memory.",
  "version": "0.1.0-alpha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Razisafir/fresh.git"
  },
  "homepage": "https://github.com/Razisafir/fresh#readme",
  "bugs": {
    "url": "https://github.com/Razisafir/fresh/issues"
  },
  "main": "dist/electron-main.js",
  "scripts": {
    "start": "npm run compile && electron .",
    "compile": "tsc --noEmit && node scripts/build-electron.cjs",
    "watch": "node scripts/build-electron.cjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json --noEmit && node scripts/run-tests.cjs",
    "test:unit": "tsc -p tsconfig.test.json --noEmit && node scripts/run-tests.cjs 'test/unit/**/*.test.ts'",
    "test:integration": "tsc -p tsconfig.test.json --noEmit && node scripts/run-tests.cjs 'test/integration/**/*.test.ts'",
    "smoke": "node scripts/smoke-test.cjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.0",
    "chai": "^5.3.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "mocha": "^11.7.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.6",
    "diff": "^9.0.0",
    "dompurify": "^3.4.11"
  },
  "dependencies": {},
  "optionalDependencies": {
    "hnswlib-node": "^3.0.0"
  },
  "build": {
    "appId": "com.kovix.desktop",
    "productName": "Kovix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "renderer/**",
      "media/**"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
