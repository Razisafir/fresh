# Kovix Environment Variables
# Copy this file to .env and fill in values as needed.

# ---- Security overrides (use with caution) ----
# Allow the app to make requests to private network addresses (RFC 1918).
# Default: false (SSRF protection enabled)
# KOVIX_ALLOW_PRIVATE_NET=true

# Allow the app to make requests to loopback addresses (127.0.0.1, ::1).
# Default: false (SSRF protection enabled)
# KOVIX_ALLOW_LOOPBACK=true

# ---- Debugging ----
# Enable verbose logging in the main process.
# Default: false
# KOVIX_DEBUG_VERBOSE=true
