/* ==========================================================================
   light-theme.css — Light theme for Kovix (07C_LIGHT_THEME_TRADEOFF.md).
   
   Activated via `<html data-theme="light">`. Falls back to dark theme
   when data-theme is absent or set to "dark".
   
   Follows the same design token structure as chat.css, but with
   light-appropriate values inspired by GitHub Light / VS Code Light+.
   ========================================================================== */

/* --------------------------------------------------------------------------
   Light theme tokens — override the :root dark tokens
   -------------------------------------------------------------------------- */
[data-theme="light"] {
  /* Surface / background — light */
  --bg-base:       #ffffff;
  --bg-surface:    #f6f8fa;
  --bg-elevated:   #ffffff;
  --bg-hover:      #f3f4f6;
  --bg-active:     #eaeef2;

  /* Text — dark for light backgrounds */
  --text-primary:  #1f2328;
  --text-secondary:#656d76;
  --text-muted:    #8b949e;
  --text-inverse:  #ffffff;

  /* Accent — same purple but slightly adjusted for light bg */
  --accent:        #5a60e6;
  --accent-hover:  #4a50d0;
  --accent-muted:  rgba(90, 96, 230, 0.10);

  /* Semantic — adjusted for light */
  --success:       #1a7f37;
  --warning:       #9a6700;
  --error:         #cf222e;
  --info:          #0969da;

  /* Borders — more visible on light */
  --border:        #d0d7de;
  --border-focus:  var(--accent);
}

/* --------------------------------------------------------------------------
   Title bar — light
   -------------------------------------------------------------------------- */
[data-theme="light"] #titlebar {
  background: #f6f8fa;
  border-bottom-color: #d0d7de;
}

[data-theme="light"] #titlebar-icon .logo {
  color: #5a60e6;
}

[data-theme="light"] .titlebar-menu-item {
  color: #1f2328;
}

[data-theme="light"] .titlebar-menu-item:hover {
  background: #eaeef2;
}

[data-theme="light"] .titlebar-title {
  color: #656d76;
}

[data-theme="light"] .titlebar-btn {
  color: #656d76;
}

[data-theme="light"] .titlebar-btn:hover {
  background: #eaeef2;
  color: #1f2328;
}

[data-theme="light"] .titlebar-btn.close:hover {
  background: #cf222e;
  color: #fff;
}

/* --------------------------------------------------------------------------
   Tab bar — light
   -------------------------------------------------------------------------- */
[data-theme="light"] #tab-bar {
  background: #f6f8fa;
  border-bottom-color: #d0d7de;
}

[data-theme="light"] .tab {
  background: #f6f8fa;
  border-right-color: #d0d7de;
  color: #656d76;
}

[data-theme="light"] .tab:hover {
  background: #eaeef2;
  color: #1f2328;
}

[data-theme="light"] .tab.active {
  background: #ffffff;
  color: #1f2328;
}

[data-theme="light"] .tab.active::after {
  background: #5a60e6;
}

[data-theme="light"] .tab-name {
  color: #656d76;
}

[data-theme="light"] .tab.active .tab-name {
  color: #1f2328;
}

[data-theme="light"] .tab-close {
  color: #8b949e;
}

[data-theme="light"] .tab-close:hover {
  background: rgba(207, 34, 46, 0.1);
  color: #cf222e;
}

[data-theme="light"] .tab.has-pending .tab-name {
  color: #9a6700;
}

/* --------------------------------------------------------------------------
   Toolbar — light
   -------------------------------------------------------------------------- */
[data-theme="light"] #toolbar {
  background: #f6f8fa;
  border-bottom-color: #d0d7de;
}

[data-theme="light"] .toolbar-btn {
  color: #656d76;
}

[data-theme="light"] .toolbar-btn:hover {
  background: #eaeef2;
  color: #1f2328;
}

[data-theme="light"] .toolbar-btn.active {
  background: rgba(90, 96, 230, 0.10);
  color: #5a60e6;
}

[data-theme="light"] .toolbar-select {
  background: #ffffff;
  border-color: #d0d7de;
  color: #656d76;
}

[data-theme="light"] .toolbar-select:hover {
  border-color: #5a60e6;
  color: #1f2328;
}

[data-theme="light"] .layout-toggle {
  background: #ffffff;
  border-color: #d0d7de;
}

[data-theme="light"] .layout-btn {
  color: #8b949e;
}

[data-theme="light"] .layout-btn:hover {
  color: #1f2328;
  background: #eaeef2;
}

[data-theme="light"] .layout-btn.active {
  background: #5a60e6;
  color: #fff;
}

[data-theme="light"] .mode-toggle {
  background: #ffffff;
  border-color: #d0d7de;
}

[data-theme="light"] .mode-btn {
  color: #8b949e;
}

[data-theme="light"] .mode-btn:hover {
  color: #1f2328;
  background: #eaeef2;
}

[data-theme="light"] .mode-btn.active {
  background: #5a60e6;
  color: #fff;
}

[data-theme="light"] .mode-btn[data-mode="swarm"].active {
  background: #8b5cf6;
}

/* --------------------------------------------------------------------------
   View/Edit Dropdowns — light
   -------------------------------------------------------------------------- */
[data-theme="light"] .view-dropdown {
  background: #ffffff;
  border-color: #d0d7de;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

[data-theme="light"] .view-dropdown-item {
  color: #1f2328;
}

[data-theme="light"] .view-dropdown-item:hover {
  background: rgba(90, 96, 230, 0.08);
}

[data-theme="light"] .shortcut-hint {
  color: #8b949e;
}

/* --------------------------------------------------------------------------
   Main content panels — light
   -------------------------------------------------------------------------- */
[data-theme="light"] #pane-filetree {
  background: #f6f8fa;
  border-right-color: #d0d7de;
}

[data-theme="light"] #pane-editor {
  background: #ffffff;
}

[data-theme="light"] #pane-chat {
  background: #f6f8fa;
  border-left-color: #d0d7de;
}

/* File tree — light */
[data-theme="light"] .file-tree-header {
  background: #f6f8fa;
  border-bottom-color: #d0d7de;
}

[data-theme="light"] .file-tree-header span {
  color: #1f2328;
}

[data-theme="light"] .file-tree-header button {
  color: #656d76;
}

[data-theme="light"] .file-tree-header button:hover {
  color: #1f2328;
  background: #eaeef2;
}

[data-theme="light"] .file-tree-container {
  scrollbar-color: #d0d7de transparent;
}

[data-theme="light"] .file-tree-empty {
  color: #8b949e;
}

[data-theme="light"] .tree-item {
  color: #1f2328;
}

[data-theme="light"] .tree-item:hover {
  background: #eaeef2;
  color: #1f2328;
}

[data-theme="light"] .tree-item.active {
  background: rgba(90, 96, 230, 0.10);
  color: #5a60e6;
}

[data-theme="light"] .tree-item.has-pending {
  color: #9a6700;
}

[data-theme="light"] .tree-chevron {
  color: #8b949e;
}

[data-theme="light"] .tree-icon.folder {
  color: #9a6700;
}

[data-theme="light"] .tree-icon.file {
  color: #656d76;
}

[data-theme="light"] .tree-name {
  color: #1f2328;
}

[data-theme="light"] .tree-pending-dot {
  background: #9a6700;
}

/* Editor — light */
[data-theme="light"] .editor-header {
  background: #ffffff;
  border-bottom-color: #d0d7de;
}

[data-theme="light"] .editor-file-path {
  color: #656d76;
}

[data-theme="light"] .editor-diff-badge {
  background: rgba(90, 96, 230, 0.10);
  color: #5a60e6;
}

[data-theme="light"] .btn-editor-accept {
  background: #1a7f37;
  color: #fff;
}

[data-theme="light"] .btn-editor-accept:hover {
  background: #238636;
}

[data-theme="light"] .btn-editor-reject {
  background: #cf222e;
  color: #fff;
}

[data-theme="light"] .btn-editor-reject:hover {
  background: #da3633;
}

[data-theme="light"] .editor-empty {
  color: #8b949e;
}

[data-theme="light"] .editor-empty-hint {
  color: #8b949e;
}

[data-theme="light"] .editor-container .monaco-editor,
[data-theme="light"] .editor-container .monaco-editor .margin,
[data-theme="light"] .editor-container .monaco-editor-background {
  background-color: #ffffff !important;
}

/* Chat — light */
[data-theme="light"] #chat-internal-header {
  background: #f6f8fa;
  border-bottom-color: #d0d7de;
}

[data-theme="light"] #message-list {
  background: #ffffff;
}

[data-theme="light"] .welcome {
  color: #8b949e;
}

[data-theme="light"] .message-user {
  background: rgba(90, 96, 230, 0.08);
  border-color: rgba(90, 96, 230, 0.15);
  color: #1f2328;
}

[data-theme="light"] .message-agent {
  background: #f6f8fa;
  border-color: #d0d7de;
  color: #1f2328;
}

[data-theme="light"] .message-system {
  color: #656d76;
}

[data-theme="light"] .message code {
  background: rgba(0,0,0,0.06);
  color: #1f2328;
}

[data-theme="light"] .message pre {
  background: #f6f8fa;
  border-color: #d0d7de;
}

/* Chat input — light */
[data-theme="light"] #input-area {
  background: #ffffff;
  border-top-color: #d0d7de;
}

[data-theme="light"] #input-box {
  background: #f6f8fa;
  color: #1f2328;
  border-color: #d0d7de;
}

[data-theme="light"] #input-box:focus {
  border-color: #5a60e6;
  box-shadow: 0 0 0 3px rgba(90, 96, 230, 0.12);
}

[data-theme="light"] #input-box::placeholder {
  color: #8b949e;
}

[data-theme="light"] #btn-send {
  background: #5a60e6;
  color: #ffffff;
}

[data-theme="light"] #btn-send:hover {
  background: #4a50d0;
}

[data-theme="light"] #btn-send:disabled {
  background: #d0d7de;
  cursor: not-allowed;
}

/* Pending bar — light */
[data-theme="light"] #pending-bar {
  background: #f6f8fa;
  border-top-color: #d0d7de;
}

/* Credit bar — light */
[data-theme="light"] .credit-bar {
  background: #f6f8fa;
  border-top-color: #d0d7de;
}

/* Tool call cards — light */
[data-theme="light"] .tool-call {
  background: #f6f8fa;
  border-color: #d0d7de;
}

[data-theme="light"] .tool-call-header {
  color: #1f2328;
}

[data-theme="light"] .tool-call-name {
  color: #0969da;
}

[data-theme="light"] .tool-call-body {
  border-top-color: #d0d7de;
  color: #656d76;
}

/* Plan card — light */
[data-theme="light"] .plan-card {
  background: #f6f8fa;
  border-color: #d0d7de;
}

[data-theme="light"] .plan-card h3 {
  color: #5a60e6;
}

/* Milestone banner — light */
[data-theme="light"] .milestone-banner {
  background: rgba(90, 96, 230, 0.08);
  border-color: rgba(90, 96, 230, 0.15);
}

/* Command confirm — light */
[data-theme="light"] .command-confirm {
  background: #f6f8fa;
  border-color: #d0d7de;
}

/* Spec card — light */
[data-theme="light"] .spec-card {
  background: #f6f8fa;
  border-color: rgba(90, 96, 230, 0.3);
}

[data-theme="light"] .spec-card-header {
  background: rgba(90, 96, 230, 0.06);
  border-bottom-color: rgba(90, 96, 230, 0.15);
}

[data-theme="light"] .spec-title {
  color: #1f2328;
}

[data-theme="light"] .spec-version {
  color: #5a60e6;
  background: rgba(90, 96, 230, 0.08);
}

[data-theme="light"] .spec-section p,
[data-theme="light"] .spec-section li {
  color: #656d76;
}

[data-theme="light"] .spec-section li {
  border-bottom-color: #d0d7de;
}

[data-theme="light"] .spec-badge {
  background: #eaeef2;
  color: #656d76;
}

[data-theme="light"] .spec-card-actions {
  border-top-color: #d0d7de;
}

/* Pre-flight card — light */
[data-theme="light"] .preflight-card {
  background: #f6f8fa;
  border-color: rgba(26, 127, 55, 0.3);
}

[data-theme="light"] .preflight-card-header {
  background: rgba(26, 127, 55, 0.06);
  border-bottom-color: rgba(26, 127, 55, 0.15);
}

[data-theme="light"] .preflight-title {
  color: #1f2328;
}

[data-theme="light"] .preflight-row {
  border-bottom-color: #eaeef2;
}

[data-theme="light"] .preflight-row select,
[data-theme="light"] .preflight-row input[type="number"] {
  background: #ffffff;
  border-color: #d0d7de;
  color: #1f2328;
}

[data-theme="light"] .preflight-card-actions {
  border-top-color: #d0d7de;
}

/* Pipeline progress — light */
[data-theme="light"] .pipeline-progress {
  background: #f6f8fa;
  border-color: #d0d7de;
}

[data-theme="light"] #pipeline-progress-label {
  color: #1f2328;
}

[data-theme="light"] .pipeline-progress-bar {
  background: #eaeef2;
}

/* Swarm — light */
[data-theme="light"] .swarm-partition-card,
[data-theme="light"] .swarm-status-panel,
[data-theme="light"] .swarm-completed-card {
  background: #f6f8fa;
  border-color: #d0d7de;
}

[data-theme="light"] .swarm-worker-card {
  background: #ffffff;
  border-color: #d0d7de;
}

[data-theme="light"] .swarm-worker-card-name {
  color: #1f2328;
}

[data-theme="light"] .swarm-worker-log {
  border-top-color: #d0d7de;
  color: #656d76;
}

/* Collapsible — light */
[data-theme="light"] .collapsible-message {
  border-color: #d0d7de;
  background: #ffffff;
}

[data-theme="light"] .collapsible-header {
  background: #f6f8fa;
}

[data-theme="light"] .collapsible-header:hover {
  background: #eef1f5;
}

[data-theme="light"] .collapsible-title {
  color: #656d76;
}

[data-theme="light"] .collapsible-body {
  border-color: #d0d7de;
}

/* First-run — light */
[data-theme="light"] .first-run-card {
  background: #ffffff;
  border-color: #d0d7de;
}

[data-theme="light"] .first-run-header {
  background: linear-gradient(135deg, rgba(90, 96, 230, 0.08), rgba(9, 105, 218, 0.04));
  border-color: #d0d7de;
}

[data-theme="light"] .first-run-title {
  color: #1f2328;
}

[data-theme="light"] .first-run-body {
  color: #656d76;
}

[data-theme="light"] .first-run-providers li {
  border-color: #f6f8fa;
}

[data-theme="light"] .first-run-providers a {
  color: #0969da;
}

[data-theme="light"] .first-run-hint {
  color: #8b949e;
}

/* Modal — light */
[data-theme="light"] .modal-content {
  background: #ffffff;
  border-color: #d0d7de;
  box-shadow: 0 8px 24px rgba(0,0,0,0.12);
}

[data-theme="light"] .modal-content h2 {
  color: #1f2328;
}

[data-theme="light"] .modal-content p {
  color: #656d76;
}

[data-theme="light"] .settings-group label {
  color: #1f2328;
}

[data-theme="light"] .settings-group input {
  background: #f6f8fa;
  border-color: #d0d7de;
  color: #1f2328;
}

[data-theme="light"] .settings-group input:focus {
  border-color: #5a60e6;
}

/* Resize handles — light */
[data-theme="light"] .resize-handle {
  background: transparent;
}

[data-theme="light"] .resize-handle:hover,
[data-theme="light"] .resize-handle.active {
  background: #5a60e6;
}

/* Scrollbars — light */
[data-theme="light"] ::-webkit-scrollbar-track {
  background: #f6f8fa;
}

[data-theme="light"] ::-webkit-scrollbar-thumb {
  background: #d0d7de;
}

[data-theme="light"] ::-webkit-scrollbar-thumb:hover {
  background: #8b949e;
}

/* Buttons — light */
[data-theme="light"] .btn-primary {
  background: #5a60e6;
  color: #ffffff;
}

[data-theme="light"] .btn-primary:hover {
  background: #4a50d0;
}

[data-theme="light"] .btn-secondary {
  background: #eaeef2;
  color: #1f2328;
  border-color: #d0d7de;
}

[data-theme="light"] .btn-secondary:hover {
  background: #d0d7de;
}

[data-theme="light"] .btn-small {
  border-color: #d0d7de;
}

[data-theme="light"] .btn-accept {
  background: #1a7f37;
  color: #fff;
}

[data-theme="light"] .btn-reject {
  background: #cf222e;
  color: #fff;
}
